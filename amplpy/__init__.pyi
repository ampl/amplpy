from typing import (
    Any,
    Dict,
    Hashable,
    Generic,
    Iterator,
    Literal,
    TypeVar,
    List,
    Iterable,
    Mapping,
    Optional,
    Sequence,
    Tuple,
    Union,
    overload
)
import pandas as pd
import logging


AMPLVariant = Optional[Union[int, float, str]]
AMPLScalar = Union[int, float, str]
AMPLIndex = Tuple[AMPLScalar, ...]
AMPLTuple = Union[AMPLScalar, List[AMPLScalar], AMPLIndex]
_EntityValue = TypeVar("_EntityValue")
_EntityT = TypeVar("_EntityT", bound="Entity[Any]")
_Data = Union[DataFrame, Dict[Any, Any], pd.DataFrame, pd.Series]
_SetMember = Union[AMPLScalar, Tuple[AMPLScalar, ...]]
_SetData = Union[_Data, Iterable[Union[AMPLScalar, Iterable[AMPLScalar]]]]
__version__: str
logger: logging.Logger

class Entity(Generic[_EntityValue]):
    def to_string(self) -> str: ...
    def toString(self) -> str: ...
    def __str__(self) -> str: ...
    def __iter__(self: _EntityT) -> Iterator[Tuple[Optional[AMPLIndex], _EntityT]]: ...
    def __getitem__(self, index: AMPLTuple) -> _EntityValue: ...
    @overload
    def get(self: _EntityT) -> _EntityT: ...
    @overload
    def get(self, index: AMPLTuple, *indices: AMPLTuple) -> _EntityValue: ...
    def find(self: _EntityT, index: AMPLTuple) -> Optional[_EntityT]: ...
    def instances(self: _EntityT) -> _InstanceIterator[_EntityT]: ...
    def name(self) -> str: ...
    def indexarity(self) -> int: ...
    def is_scalar(self) -> bool: ...
    def isScalar(self) -> bool: ...
    def num_instances(self) -> int: ...
    def numInstances(self) -> int: ...
    def get_indexing_sets(self) -> List[str]: ...
    def getIndexingSets(self) -> List[str]: ...
    def xref(self) -> List[str]: ...
    def get_values(self, suffixes: Optional[Union[str, Iterable[str]]] = None) -> DataFrame: ...
    def getValues(self, suffixes: Optional[Union[str, Iterable[str]]] = None) -> DataFrame: ...
    def to_pandas(self, **kwargs: Any) -> pd.DataFrame: ...
    def to_dict(self, **kwargs: Any) -> Dict[Hashable, Union[AMPLVariant, Tuple[AMPLVariant, ...]]]: ...
    def to_list(self, **kwargs: Any) -> List[Union[AMPLVariant, Tuple[AMPLVariant, ...]]]: ...
    def set_values(self, data: _Data) -> None: ...
    def setValues(self, data: _Data) -> None: ...
    def set_suffix(self, suffix: str, value: Union[float, str, DataFrame, pd.DataFrame, pd.Series]) -> None: ...
    def expand(self) -> str: ...

class Constraint(Entity["Constraint"]):
    def __setitem__(self, index: AMPLTuple, value: float) -> None: ...
    def is_logical(self) -> bool: ...
    def isLogical(self) -> bool: ...
    def drop(self) -> None: ...
    def restore(self) -> None: ...
    def body(self) -> float: ...
    def astatus(self) -> str: ...
    def defvar(self) -> int: ...
    def dinit(self) -> float: ...
    def dinit0(self) -> float: ...
    def dual(self) -> float: ...
    def lb(self) -> float: ...
    def ub(self) -> float: ...
    def lbs(self) -> float: ...
    def ubs(self) -> float: ...
    def ldual(self) -> float: ...
    def udual(self) -> float: ...
    def lslack(self) -> float: ...
    def uslack(self) -> float: ...
    def slack(self) -> float: ...
    def sstatus(self) -> str: ...
    def status(self) -> str: ...
    def set_dual(self, dual: Union[int, float]) -> None: ...
    def setDual(self, dual: Union[int, float]) -> None: ...
    def val(self) -> Optional[float]: ...

class Objective(Entity["Objective"]):
    def value(self) -> float: ...
    def astatus(self) -> str: ...
    def sstatus(self) -> str: ...
    def exitcode(self) -> int: ...
    def message(self) -> str: ...
    def result(self) -> str: ...
    def drop(self) -> None: ...
    def restore(self) -> None: ...
    def minimization(self) -> bool: ...

class Parameter(Entity[AMPLVariant]):
    def __setitem__(self, index: AMPLTuple, value: AMPLVariant) -> None: ...
    def is_symbolic(self) -> bool: ...
    def isSymbolic(self) -> bool: ...
    def has_default(self) -> bool: ...
    def hasDefault(self) -> bool: ...
    def __getitem__(self, index: AMPLTuple) -> AMPLVariant: ...
    def value(self) -> AMPLVariant: ...
    def set(self, *args: Any) -> None: ...
    def set_values(self, values: Any) -> None: ...
    def setValues(self, values: Any) -> None: ...

class Set(Entity["Set"]):
    def __setitem__(self, index: AMPLTuple, value: _SetData) -> None: ...
    # Scalar sets yield members; indexed sets yield (index, Set) pairs.
    def __iter__(self) -> Iterator[Any]: ...
    def instances(self: _EntityT) -> _InstanceIterator[_EntityT]: ...
    def arity(self) -> int: ...
    # Unlike other entities, sets do not accept suffix arguments.
    def get_values(self) -> DataFrame: ...  # type: ignore[override]
    def getValues(self) -> DataFrame: ...  # type: ignore[override]
    def members(self) -> Iterator[_SetMember]: ...
    def size(self) -> int: ...
    def contains(self, t: AMPLTuple) -> bool: ...
    def set_values(self, values: _SetData) -> None: ...
    def setValues(self, values: _SetData) -> None: ...

class Variable(Entity["Variable"]):
    def __setitem__(self, index: AMPLTuple, value: Union[float, int, Parameter]) -> None: ...
    def value(self) -> float: ...
    def fix(self, value: Optional[float] = None) -> None: ...
    def unfix(self) -> None: ...
    def set_value(self, value: Union[float, int, Parameter]) -> None: ...
    def setValue(self, value: Union[float, int, Parameter]) -> None: ...
    def astatus(self) -> str: ...
    def defeqn(self) -> int: ...
    def dual(self) -> float: ...
    def init(self) -> float: ...
    def init0(self) -> float: ...
    def lb(self) -> float: ...
    def ub(self) -> float: ...
    def lb0(self) -> float: ...
    def ub0(self) -> float: ...
    def lb1(self) -> float: ...
    def ub1(self) -> float: ...
    def lb2(self) -> float: ...
    def ub2(self) -> float: ...
    def lrc(self) -> float: ...
    def urc(self) -> float: ...
    def lslack(self) -> float: ...
    def uslack(self) -> float: ...
    def rc(self) -> float: ...
    def slack(self) -> float: ...
    def sstatus(self) -> str: ...
    def status(self) -> str: ...

class _InstanceIterator(Iterator[Tuple[Optional[AMPLIndex], _EntityT]]):
    def __iter__(self) -> _InstanceIterator[_EntityT]: ...
    def __next__(self) -> Tuple[Optional[AMPLIndex], _EntityT]: ...
    def size(self) -> int: ...
    def __len__(self) -> int: ...

class EntityMap(Iterator[Tuple[str, _EntityT]]):
    def __iter__(self) -> EntityMap[_EntityT]: ...
    def __next__(self) -> Tuple[str, _EntityT]: ...
    def __getitem__(self, key: str) -> _EntityT: ...
    def size(self) -> int: ...
    def __len__(self) -> int: ...

# The property helpers iterate over (name, entity) pairs.
class Variables:
    def __getitem__(self, name: str) -> Variable: ...
    def __setitem__(self, name: str, value: Union[float, _Data]) -> None: ...
    def __iter__(self) -> EntityMap[Variable]: ...

class Constraints:
    def __getitem__(self, name: str) -> Constraint: ...
    def __setitem__(self, name: str, value: Union[float, _Data]) -> None: ...
    def __iter__(self) -> EntityMap[Constraint]: ...

class Objectives:
    def __getitem__(self, name: str) -> Objective: ...
    def __iter__(self) -> EntityMap[Objective]: ...

class Sets:
    def __getitem__(self, name: str) -> Set: ...
    def __setitem__(self, name: str, values: _SetData) -> None: ...
    def __iter__(self) -> EntityMap[Set]: ...

class Parameters:
    def __getitem__(self, name: str) -> Parameter: ...
    def __setitem__(self, name: str, value: Union[AMPLScalar, _Data, Iterable[AMPLScalar]]) -> None: ...
    def __iter__(self) -> EntityMap[Parameter]: ...

class Options:
    def __getitem__(self, name: str) -> AMPLVariant: ...
    def __setitem__(self, name: str, value: Union[AMPLScalar, Mapping[str, Union[AMPLScalar, bool]]]) -> None: ...

class Environment:
    def __init__(self, binary_directory: Optional[str] = None, binary_name: Optional[str] = None) -> None: ...
    def __str__(self) -> str: ...
    def __iter__(self) -> Iterator[Tuple[str, str]]: ...
    def __setitem__(self, name: str, value: str) -> None: ...
    def __getitem__(self, name: str) -> Union[str, None]: ...
    def to_string(self) -> str: ...
    def set_bin_dir(self, binary_directory: str) -> None: ...
    def get_bin_dir(self) -> str: ...
    def set_bin_name(self, binary_name: str) -> None: ...
    def get_bin_name(self) -> str: ...

    toString = to_string
    setBinDir = set_bin_dir
    getBinDir = get_bin_dir
    setBinName = set_bin_name
    getBinName = get_bin_name

class OutputHandler:
    def output(self, kind: int, msg: str) -> None: ...

class ErrorHandler:
    def error(self, exception: AMPLException) -> None: ...
    def warning(self, exception: AMPLException) -> None: ...

class AMPL:
    var: Variables
    con: Constraints
    obj: Objectives
    set: Sets
    param: Parameters
    @property
    def option(self) -> Options: ...
    @option.setter
    def option(self, options_dict: Mapping[str, Any]) -> None: ...
    def __init__(self, environment: Optional[Environment] = None) -> None: ...
    def get_data(self, *statements: str) -> DataFrame: ...
    def getData(self, *statements: str) -> DataFrame: ...
    def get_entity(self, name: str) -> Entity[Any]: ...
    def getEntity(self, name: str) -> Entity[Any]: ...
    def get_variable(self, name: str) -> Variable: ...
    def getVariable(self, name: str) -> Variable: ...
    def get_constraint(self, name: str) -> Constraint: ...
    def getConstraint(self, name: str) -> Constraint: ...
    def get_objective(self, name: str) -> Objective: ...
    def getObjective(self, name: str) -> Objective: ...
    def get_set(self, name: str) -> Set: ...
    def getSet(self, name: str) -> Set: ...
    def get_parameter(self, name: str) -> Parameter: ...
    def getParameter(self, name: str) -> Parameter: ...
    def eval(self, statements: str) -> None: ...
    def get_output(self, statements: str) -> str: ...
    def getOutput(self, statements: str) -> str: ...
    def reset(self) -> None: ...
    def close(self) -> None: ...
    def is_running(self) -> bool: ...
    def isRunning(self) -> bool: ...
    @overload
    def solve(self, problem: str = "", solver: str = "", verbose: bool = True, *, return_output: Literal[True], **kwargs: Any) -> str: ...
    @overload
    def solve(self, problem: str, solver: str, verbose: bool, return_output: Literal[True], **kwargs: Any) -> str: ...
    @overload
    def solve(self, problem: str = "", solver: str = "", verbose: bool = True, return_output: Literal[False] = False, **kwargs: Any) -> None: ...
    @overload
    def solve(self, problem: str = "", solver: str = "", verbose: bool = True, return_output: bool = False, **kwargs: Any) -> Optional[str]: ...
    def cd(self, path: Optional[str] = None) -> str: ...
    def set_option(self, name: str, value: Union[bool, int, float, str]) -> None: ...
    def setOption(self, name: str, value: Union[bool, int, float, str]) -> None: ...
    def get_option(self, name: str) -> AMPLVariant: ...
    def getOption(self, name: str) -> AMPLVariant: ...
    def reset_options(self) -> None: ...
    def resetOptions(self) -> None: ...
    def read(self, filename: str) -> None: ...
    def read_data(self, filename: str) -> None: ...
    def readData(self, filename: str) -> None: ...
    def get_value(self, scalar_expression: str) -> AMPLVariant: ...
    def getValue(self, scalar_expression: str) -> AMPLVariant: ...
    def set_data(self, data: Union[DataFrame, pd.DataFrame, pd.Series], set_name: Optional[str] = None) -> None: ...
    def setData(self, data: Union[DataFrame, pd.DataFrame, pd.Series], set_name: Optional[str] = None) -> None: ...
    def read_table(self, table_name: str) -> None: ...
    def readTable(self, table_name: str) -> None: ...
    def write_table(self, table_name: str) -> None: ...
    def writeTable(self, table_name: str) -> None: ...
    def display(self, *ampl_expressions: Any) -> None: ...
    def set_output_handler(self, output_handler: OutputHandler) -> None: ...
    def setOutputHandler(self, output_handler: OutputHandler) -> None: ...
    def set_error_handler(self, error_handler: ErrorHandler) -> None: ...
    def setErrorHandler(self, error_handler: ErrorHandler) -> None: ...
    def get_output_handler(self) -> OutputHandler: ...
    def getOutputHandler(self) -> OutputHandler: ...
    def get_error_handler(self) -> ErrorHandler: ...
    def getErrorHandler(self) -> ErrorHandler: ...
    def get_variables(self) -> EntityMap[Variable]: ...
    def getVariables(self) -> EntityMap[Variable]: ...
    def get_constraints(self) -> EntityMap[Constraint]: ...
    def getConstraints(self) -> EntityMap[Constraint]: ...
    def get_objectives(self) -> EntityMap[Objective]: ...
    def getObjectives(self) -> EntityMap[Objective]: ...
    def get_sets(self) -> EntityMap[Set]: ...
    def getSets(self) -> EntityMap[Set]: ...
    def get_parameters(self) -> EntityMap[Parameter]: ...
    def getParameters(self) -> EntityMap[Parameter]: ...
    def get_current_objective(self) -> Optional[Objective]: ...
    def getCurrentObjective(self) -> Optional[Objective]: ...
    def _var(self) -> Variables: ...
    def _con(self) -> Constraints: ...
    def _obj(self) -> Objectives: ...
    def _set(self) -> Sets: ...
    def _param(self) -> Parameters: ...
    def _option(self) -> Options: ...
    def _set_option(self, options_dict:  Dict[str, Any]) -> None: ...
    def export_model(self, filename: str = "") -> str: ...
    def exportModel(self, filename: str = "") -> str: ...
    def export_data(self, filename: str = "") -> str: ...
    def exportData(self, filename: str = "") -> str: ...
    def snapshot(self, filename: str = "", model: bool = True, data: bool = True, options: bool = True) -> str: ...
    def write(self, filename: str, auxfiles:str = "") -> None: ...
    def expand(self) -> str: ...
    def show(self) -> str: ...
    @property
    def solve_result(self) -> str: ...
    @property
    def solve_result_num(self) -> int: ...
    def get_iis(self, flat: bool = True) -> Tuple[Dict[str, Any], Dict[str, Any]]: ...
    def get_solution(self, flat: bool = True, zeros: bool = False) -> Dict[str, Any]: ...
    def _start_recording(self, filename: str) -> None: ...
    def _startRecording(self, filename: str) -> None: ...
    def _stop_recording(self) -> None: ...
    def _stopRecording(self) -> None: ...
    def _load_session(self, filename: str) -> None: ...
    def _loadSession(self, filename: str) -> None: ...
    def to_ampls(self, driver: str, options: Optional[Mapping[str, Any]] = ...) -> Any: ...
    def import_ampls_solution(
        self,
        model: Any,
        number: Optional[int] = ...,
        import_entities: bool = ...,
        keep_files: bool = ...
    ) -> None: ...
    def to_string(self) -> str: ...
    def toString(self) -> str: ...
    def __str__(self) -> str: ...

class Row:
    def __str__(self) -> str: ...
    def __iter__(self) -> Iterator[AMPLVariant]: ...
    def __getitem__(self, key: int) -> AMPLVariant: ...
    def to_string(self) -> str: ...
    toString = to_string

class Column:
    def __str__(self) -> str: ...
    def __iter__(self) -> Iterator[AMPLVariant]: ...
    def to_string(self) -> str: ...
    def to_list(self) -> List[AMPLVariant]: ...
    toString = to_string
    toList = to_list

_Headers = Union[str, Iterable[Union[str, Tuple[str, Iterable[AMPLVariant]]]]]

class DataFrame:
    def __init__(self, index: Optional[_Headers], columns: _Headers = (), **kwargs: Any) -> None: ...
    def __str__(self) -> str: ...
    def __iter__(self) -> Iterator[Row]: ...
    def to_string(self) -> str: ...
    def to_dict(self) -> Dict[Hashable, Union[AMPLVariant, Tuple[AMPLVariant, ...]]]: ...
    def to_list(self, skip_index: bool = False) -> List[Union[AMPLVariant, Tuple[AMPLVariant, ...]]]: ...
    def to_pandas(self, multi_index: bool = True) -> pd.DataFrame: ...
    @classmethod
    def from_dict(cls, dic: Dict[Any, Any], index_names: Optional[Sequence[str]] = None, column_names: Optional[Sequence[str]] = None) -> DataFrame: ...
    @classmethod
    def from_pandas(cls, df: Union[pd.DataFrame, pd.Series], index_names: Optional[Sequence[str]] = None, indexarity: Optional[int] = None) -> DataFrame: ...
    @classmethod
    def from_numpy(cls, data: Any) -> DataFrame: ...
    def _get_num_cols(self) -> int: ...
    def _get_num_rows(self) -> int: ...
    def _get_num_indices(self) -> int: ...
    def _add_row(self, *value: Union[AMPLVariant, Sequence[AMPLVariant]]) -> None: ...
    def _add_column(self, header: str, values: Optional[Sequence[AMPLVariant]] = None) -> None: ...
    def _get_column(self, header: str) -> Column: ...
    def _set_column(self, header: str, values: Sequence[AMPLVariant]) -> None: ...
    def _get_row(self, key: AMPLTuple) -> Row: ...
    def _get_row_by_index(self, index: int) -> Row: ...
    def _get_headers(self) -> Tuple[str, ...]: ...
    def _set_values(self, values: Dict[Any, Any]) -> None: ...
    _addColumn = _add_column
    _addRow = _add_row
    _getColumn = _get_column
    _getHeaders = _get_headers
    _getNumCols = _get_num_cols
    _getNumIndices = _get_num_indices
    _getNumRows = _get_num_rows
    _getRow = _get_row
    _getRowByIndex = _get_row_by_index
    _setColumn = _set_column
    _setValues = _set_values
    fromDict = from_dict
    fromNumpy = from_numpy
    fromPandas = from_pandas
    toDict = to_dict
    toList = to_list
    toPandas = to_pandas
    toString = to_string

class AMPLException(Exception):
    def __init__(self, source_name: str, line_number: int, offset: int, message: str) -> None: ...
    def get_source_name(self) -> str: ...
    def get_line_number(self) -> int: ...
    def get_offset(self) -> int: ...
    def get_message(self) -> str: ...
    getSourceName = get_source_name
    getLineNumber = get_line_number
    getOffset = get_offset
    getMessage = get_message

class PresolveException(RuntimeError): ...
class InfeasibilityException(RuntimeError): ...

def add_to_path(path: str, head: bool = True) -> None: ...
def multidict(d: Dict[Hashable, Sequence[Any]]) -> List[Any]: ...
def register_magics(store_name: str = "_ampl_cells", ampl_object: Optional[AMPL] = None, globals_: Optional[Dict[str, Any]] = None) -> None: ...
def ampl_notebook(modules: Iterable[str] = (), license_uuid: Optional[str] = None, reinstall: bool = False, verbose: bool = False, show_license: Optional[bool] = None, **kwargs: Any) -> AMPL: ...

